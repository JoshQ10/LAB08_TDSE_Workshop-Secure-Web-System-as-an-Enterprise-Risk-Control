[Unit]
Description=Enterprise Risk API
After=network.target

[Service]
User=riskapi
WorkingDirectory=/opt/enterprise-risk-api
# Auth0 tenant (keep https:// and the trailing slash).
Environment="SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://dev-mzsxo8m40hsfdx3h.us.auth0.com/"
Environment="SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_AUDIENCES=https://enterprise-risk-api"
# Bind only to loopback: Apache is the only public entry point.
Environment="SERVER_ADDRESS=127.0.0.1"
# Duck DNS hostname of the deployment.
Environment="APP_CORS_ALLOWED_ORIGINS=https://joshua-risk-lab.duckdns.org"
ExecStart=/usr/bin/java -jar /opt/enterprise-risk-api/app.jar
Restart=always
RestartSec=5

# Least-privilege hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
